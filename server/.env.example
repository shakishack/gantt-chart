# Server Port
PORT=5000

# Environment Mode (development or production)
NODE_ENV=development

# PostgreSQL Connection String (or set individual DB variables below)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gantt_chart_db

# Alternative individual DB credentials (if DATABASE_URL is not provided)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gantt_chart_db
DB_USER=postgres
DB_PASSWORD=postgres

# Allowed Frontend Origin for CORS
CLIENT_ORIGIN=http://localhost:5173
